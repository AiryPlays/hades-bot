import discord
from discord.ext import commands
import asyncio

# Intents
intents=discord.Intents.default()
intents.message_content
intents.members=True  # theut this is for mute, kick and bans

bot=commands.Bot(command_prefix="-", intents=intents, help_command=None)

# Startup
@bot.event
async def on_ready():
print(f'Logged in as {bot.user} ID: {bot.user.id})')
print('--CODED BY @Airy --')
await bot.change_presence(activity=discord.Game(name="Hades Studios"))

# Command List
@bot.command(name='help')
async def help_command(ctx):
    embed=discord.Embed(title="Hades Studios Commands",description="Commands for the bot you are using currently.", color=0)
    embed.add_field(name="-announce <message>", value="Send an announcement to the channel you are currently in.")
    embed.add_field
    embed.add_field
